/* ----------------------------------------------------------------- */
/* CUSTMENU - entry point for the customer inquiry                   */
/* Sample CLLE for the IBM Bob + TOBi automated build loop.          */
/* ----------------------------------------------------------------- */
             PGM

             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             RTVJOBA    USER(&USER)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Customer inquiry started by' *BCAT &USER) +
                          TOPGMQ(*EXT) MSGTYPE(*STATUS)
             CALL       PGM(CUSTINQ)
             RETURN

 ERROR:      SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('CUSTINQ ended in error. See the job log.') +
                          MSGTYPE(*ESCAPE)
             ENDPGM
