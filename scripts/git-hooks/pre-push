#!/usr/bin/env bash
# Optional pre-push hook: compile every IBM i source changed on this branch
# before it's pushed. No AI involved - it just blocks the push if the compile fails.
# Install:  cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Skip once: git push --no-verify
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=$(command -v python3 || command -v python)
base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo origin/main)
"$PY" .bob/skills/ibmi-build-object/scripts/ibmi_build.py changed --base "$base" --new-run --max-fix-attempts 0
rc=$?
case $rc in
  0|4) exit 0 ;;                                   # compiled, or nothing to compile
  2)   echo "pre-push: IBM i build environment unavailable - push allowed, build skipped."; exit 0 ;;
  *)   echo "pre-push: IBM i compile failed. Run /ibmi-build-object --changed --base $base in Bob to fix."; exit 1 ;;
esac
